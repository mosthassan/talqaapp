rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // المحتوى العام (الباقات، نقاط التوزيع، الإعلانات، القنوات، عناصر الاستراحة، الإعدادات)
    // القراءة متاحة للجميع (مشتركي الشبكة أوفلاين وأونلاين)
    // الكتابة محصورة بمسؤولي النظام المسجلين في Firebase Auth
    match /packages/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /distributors/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /channels/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /lounge_items/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================================================
    // مسابقة الولاء وصندوق الجوائز (Server-Authoritative)
    // =========================================================
    // حماية صندوق الجوائز: ممنوع أي قراءة أو كتابة من متصفح العميل
    // القراءة والكتابة محصورة بالسيرفر أو المشرف المصادق عليه
    match /reward_vault/{rewardId} {
      allow read, write: if request.auth != null;
    }

    // سجل الكروت المحروقة: لا يمكن للعميل قراءتها أو التلاعب بها
    match /consumed_vouchers/{voucherCode} {
      allow read, write: if request.auth != null;
    }

    // سجل العمليات والمطالبات الفائزة
    match /reward_claims/{claimId} {
      allow read, write: if request.auth != null;
    }

    // قاعدة كروت شبكة طلقة للتحقق
    match /network_cards_ledger/{cardCode} {
      allow read, write: if request.auth != null;
    }

    // مفاتيح عدم التكرار (Idempotency)
    match /loyalty_idempotency/{key} {
      allow read, write: if request.auth != null;
    }
  }
}
