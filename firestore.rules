rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================
    // المحتوى العام لشبكة طلقة نت (الباقات، الموزعين، الإعلانات، القنوات، الاستراحة)
    // =========================================================
    // القراءة متاحة للجميع (مشتركي الشبكة أوفلاين وأونلاين)
    // الكتابة محصورة حصراً بالمدير المعتمد الذي يحمل Custom Claim (admin: true)
    match /packages/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /distributors/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /channels/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /lounge_items/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // =========================================================
    // المجموعات الحساسة الخاصة بمسابقة الولاء والجوائز والمالك
    // =========================================================
    // حماية تامة ومطلقة: ممنوع أي قراءة أو كتابة من متصفح العميل مباشرة
    // (حتى لو كان مسجلاً دخول بجوجل، لأن التسجيل العام متاح للجميع)
    // الوصول يتم حصراً من السيرفر الموثوق عبر Firebase Admin SDK
    match /reward_vault/{rewardId} {
      allow read, write: if false;
    }

    match /consumed_vouchers/{voucherCode} {
      allow read, write: if false;
    }

    match /reward_claims/{claimId} {
      allow read, write: if false;
    }

    match /network_cards_ledger/{cardCode} {
      allow read, write: if false;
    }

    match /loyalty_idempotency/{key} {
      allow read, write: if false;
    }

    match /admin_config/{doc} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }
  }
}
